  "principles": [
    {
      "id": "encounter",
      "weight": 1,
      "rule": "A poem moves toward a singular Other; the address must alter the route rather than decorate it.",
      "sources": ["celan-bremen", "celan-meridian", "hearing-residues"]
    },
    {
      "id": "attention",
      "weight": 0.96,
      "rule": "Attend to the introduced object's material details before translating it into inherited motifs.",
      "sources": ["celan-meridian", "user-seven"]
    },
    {
      "id": "object-autonomy",
      "weight": 0.94,
      "rule": "Objects are acting nodes and possible witnesses, not replaceable symbols with one fixed key.",
      "sources": ["user-seven", "dichtung-uebergang", "celan-meridian"]
    },
    {
      "id": "unfinished-memory",
      "weight": 0.98,
      "rule": "The past remains unfinished; the poem may preserve a question but must not manufacture closure.",
      "sources": ["eliezer-silence", "willms-wound"]
    },
    {
      "id": "damaged-language",
      "weight": 0.91,
      "rule": "Compression, compounds, syntactic fracture and pauses are semantic operations on damaged language.",
      "sources": ["user-seven", "hearing-residues", "bruckinger-image"]
    },
    {
      "id": "productive-silence",
      "weight": 0.97,
      "rule": "Silence is an ethical interval and a condition of listening, not merely inability or blankness.",
      "sources": ["eliezer-silence", "celan-meridian", "hearing-residues"]
    },
    {
      "id": "wound-without-redemption",
      "weight": 1,
      "rule": "A wound can expose truth, relation or resistance, but it cannot be redeemed by a convenient positive ending.",
      "sources": ["willms-wound", "dichtung-uebergang"]
    },
    {
      "id": "hope-without-guarantee",
      "weight": 0.88,
      "rule": "Birth, ascent and orientation may remain possible, but never as guaranteed salvation.",
      "sources": ["user-seven", "willms-wound"]
    },
    {
      "id": "internal-composition",
      "weight": 0.93,
      "rule": "Meaning must arise from the poem's internal sequence; external references cannot replace compositional logic.",
      "sources": ["dichtung-uebergang", "user-seven"]
    },
    {
      "id": "openness",
      "weight": 0.95,
      "rule": "The final state should remain an addressed residue, path or open question, never a paraphrasable moral.",
      "sources": ["celan-meridian", "user-seven", "eliezer-silence"]
    }
  ],
