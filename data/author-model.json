  "claims": [
    {"id":"c001","from":"stone","relation":"sides_with","to":"du","operation":"witness","weight":1,"sources":["user-seven","dichtung-uebergang","celan-meridian"],"note":"In the lark-shaped stone, a non-human object takes the side of the addressed Other."},
    {"id":"c002","from":"stone","relation":"holds_tension","to":"flight","operation":"inversion","weight":1,"sources":["user-seven"],"note":"Stone and bird join weight to ascent, silence to song."},
    {"id":"c003","from":"stone","relation":"carries","to":"death","operation":"burden","weight":0.92,"sources":["user-seven"],"note":"The stone carries a dying light rather than merely signifying inert matter."},
    {"id":"c004","from":"flight","relation":"destabilizes","to":"height","operation":"inversion","weight":0.86,"sources":["user-seven"],"note":"Height itself can whirl and lose stability."},
    {"id":"c005","from":"darkness","relation":"approaches_through","to":"du","operation":"approach","weight":1,"sources":["user-seven"],"note":"Darkening can be a movement across toward the Other."},
    {"id":"c006","from":"light","relation":"coerces","to":"movement","operation":"constraint","weight":1,"sources":["user-seven","eliezer-silence"],"note":"Light can impose a necessity of movement rather than offer innocent clarity."},
    {"id":"c007","from":"light","relation":"leaves","to":"trace","operation":"residue","weight":0.91,"sources":["user-seven"],"note":"Afterglow is residual light carried as a burden."},
    {"id":"c008","from":"loss","relation":"casts","to":"trace","operation":"fold","weight":1,"sources":["user-seven"],"note":"Loss can serve as a mold that produces a mask or trace without restoring presence."},
    {"id":"c009","from":"trace","relation":"fades_into","to":"gray","operation":"erasure","weight":0.95,"sources":["user-seven"],"note":"Trace moves toward gray, where preservation and disappearance coexist."},
    {"id":"c010","from":"gray","relation":"holds_tension","to":"erasure","operation":"residue","weight":0.92,"sources":["user-seven"],"note":"Gray soberly preserves while erasing and rejects decorative resolution."},
    {"id":"c011","from":"fragment","relation":"seals","to":"wound","operation":"preserve","weight":0.93,"sources":["user-seven"],"note":"Fragments can become the structure that seals damaged space."},
    {"id":"c012","from":"mine","relation":"delays","to":"catastrophe","operation":"latency","weight":1,"sources":["user-seven"],"note":"The mine embeds potential catastrophe in space and time."},
    {"id":"c013","from":"mine","relation":"holds_tension","to":"birth","operation":"inversion","weight":0.87,"sources":["user-seven"],"note":"Destructive technology and a demand for just birth coexist without cancellation."},
    {"id":"c014","from":"birth","relation":"opens_without_guarantee","to":"future","operation":"opening","weight":0.92,"sources":["user-seven","willms-wound"],"note":"Birth carries radical hope but does not promise salvation."},
    {"id":"c015","from":"death","relation":"burdens","to":"survivor","operation":"burden","weight":0.93,"sources":["user-seven"],"note":"Death may be borne or carried to completion as a survivor's debt."},
    {"id":"c016","from":"wound","relation":"opens","to":"movement","operation":"breach","weight":0.91,"sources":["user-seven","willms-wound"],"note":"Violent waking and injury can reopen movement without healing the wound."},
    {"id":"c017","from":"wound","relation":"exposes","to":"truth","operation":"witness","weight":1,"sources":["willms-wound"],"note":"The wound makes an ethical demand for recognition and truth."},
    {"id":"c018","from":"wound","relation":"resists","to":"redemption","operation":"refusal","weight":1,"sources":["willms-wound","dichtung-uebergang"],"note":"Pain cannot be resolved by a compensatory promise."},
    {"id":"c019","from":"wound","relation":"coexists_with","to":"fruitful_process","operation":"simultaneity","weight":0.9,"sources":["willms-wound"],"note":"Wounding and productive movement can occur simultaneously rather than sequentially."},
    {"id":"c020","from":"memory","relation":"keeps_unfinished","to":"past","operation":"remembrance","weight":1,"sources":["eliezer-silence","willms-wound"],"note":"Remembrance refuses to treat the past as completed."},
    {"id":"c021","from":"memory","relation":"returns_without_restoring","to":"home","operation":"homecoming","weight":0.94,"sources":["willms-wound"],"note":"Homecoming includes the uncanny and does not restore an intact origin."},
    {"id":"c022","from":"silence","relation":"makes_room_for","to":"listening","operation":"interval","weight":1,"sources":["eliezer-silence","hearing-residues"],"note":"Silence can be an ethical interval in which the Other can be heard."},
    {"id":"c023","from":"silence","relation":"holds_tension","to":"future_speech","operation":"not_yet","weight":0.96,"sources":["eliezer-silence"],"note":"Silence holds both no-longer and not-yet rather than simple lack."},
    {"id":"c024","from":"silence","relation":"refuses","to":"premature_answer","operation":"refusal","weight":1,"sources":["eliezer-silence"],"note":"Ethical negativity leaves the question open instead of producing positivity too soon."},
    {"id":"c025","from":"breath","relation":"alternates_with","to":"du","operation":"dialogue","weight":1,"sources":["hearing-residues","celan-meridian"],"note":"Breath-turn is an alternation of speaking and listening, not only inward transformation."},
    {"id":"c026","from":"hearing","relation":"receives","to":"distance","operation":"reception","weight":0.92,"sources":["hearing-residues"],"note":"Hearing operates across distance and survives in sensory residues."},
    {"id":"c027","from":"hearing","relation":"resists","to":"forced_speech","operation":"refusal","weight":0.91,"sources":["hearing-residues"],"note":"Listening and dialogue oppose standardized or coerced speech."},
    {"id":"c028","from":"word","relation":"arrives_toward","to":"du","operation":"approach","weight":1,"sources":["celan-bremen","celan-meridian","glazova-speak"],"note":"The poem is on the way like a message seeking a singular heartland."},
    {"id":"c029","from":"word","relation":"passes_through","to":"silence","operation":"breath_turn","weight":0.98,"sources":["celan-meridian","eliezer-silence"],"note":"Actualized language approaches silence while remaining an address."},
    {"id":"c030","from":"word","relation":"is_wounded_by","to":"reality","operation":"exposure","weight":1,"sources":["celan-bremen"],"note":"Language moves with a mortal speaker who has been wounded by reality."},
    {"id":"c031","from":"word","relation":"orients","to":"reality","operation":"orientation","weight":0.96,"sources":["celan-bremen"],"note":"Writing sketches reality and asks where from and where to."},
    {"id":"c032","from":"attention","relation":"names_as","to":"du","operation":"encounter","weight":1,"sources":["celan-meridian"],"note":"Attentive naming allows the addressed thing to co-speak its own time."},
    {"id":"c033","from":"object","relation":"can_witness","to":"history","operation":"witness","weight":0.96,"sources":["dichtung-uebergang","user-seven"],"note":"Non-human objects can join a community of witnesses."},
    {"id":"c034","from":"water","relation":"murmurs","to":"trace","operation":"underpass","weight":0.88,"sources":["dichtung-uebergang"],"note":"Underground-water traces provide a non-human, submerged mode of testimony."},
    {"id":"c035","from":"fragment","relation":"breaks","to":"typography","operation":"line_break","weight":0.9,"sources":["bruckinger-image","dichtung-uebergang"],"note":"Graphic fractures and blank space are part of meaning, not page decoration."},
    {"id":"c036","from":"scratch","relation":"inscribes","to":"wound","operation":"mark","weight":0.89,"sources":["bruckinger-image"],"note":"Engraved marks can be read as primitive traces and psychic lesions."},
    {"id":"c037","from":"image","relation":"resonates_with","to":"word","operation":"pairing","weight":0.86,"sources":["bruckinger-image"],"note":"Image and poem remain equal partners connected by motif, gesture and opposition."},
    {"id":"c038","from":"eye","relation":"folds","to":"distance","operation":"fold","weight":0.94,"sources":["user-seven"],"note":"The eyelid fold turns intimate proximity into a structured distance."},
    {"id":"c039","from":"eye","relation":"leaves","to":"trace","operation":"residue","weight":0.87,"sources":["user-seven","hearing-residues"],"note":"Seeing persists as a residue rather than intact perception."},
    {"id":"c040","from":"machine","relation":"receives","to":"signal","operation":"technicalize","weight":0.9,"sources":["user-seven","hearing-residues"],"note":"Technical vocabulary can model reception, control and transition without becoming romantic metaphor."},
    {"id":"c041","from":"beacon","relation":"guides","to":"word","operation":"arrival","weight":1,"sources":["user-seven"],"note":"Collected beacons guide an arriving word through the night."},
    {"id":"c042","from":"flight","relation":"increases","to":"distance","operation":"approach","weight":0.93,"sources":["user-seven"],"note":"Ascent can make approach harder by increasing distance."},
    {"id":"c043","from":"thread","relation":"holds","to":"flight","operation":"retention","weight":0.92,"sources":["user-seven"],"note":"A tether can connect ascent to the ground while also restraining it."},
    {"id":"c044","from":"shell","relation":"ruptures_into","to":"trace","operation":"breach","weight":0.9,"sources":["user-seven","willms-wound"],"note":"A boundary can expose its interior through rupture and leave a material remainder."},
    {"id":"c045","from":"air","relation":"carries","to":"voice","operation":"transmission","weight":0.89,"sources":["hearing-residues","celan-meridian"],"note":"Air is both the medium of voice and the interval that can interrupt it."},
    {"id":"c046","from":"sphere","relation":"holds_tension","to":"rupture","operation":"pressure","weight":0.88,"sources":["user-seven"],"note":"A complete shell is defined by the pressure that may break it."},
    {"id":"c047","from":"darkness","relation":"shelters","to":"persistence","operation":"concealment","weight":0.91,"sources":["user-seven","hearing-residues"],"note":"The thicket and darkness can preserve resistant life and permit passage."},
    {"id":"c048","from":"scientific_name","relation":"shelters","to":"object","operation":"renaming","weight":0.84,"sources":["hearing-residues"],"note":"Exact names can avoid contaminated symbolism while enabling poem-specific symbolic force."},
    {"id":"c049","from":"compound","relation":"compresses","to":"relation","operation":"neologism","weight":0.95,"sources":["user-seven","hearing-residues"],"note":"Compounds rename the world by forcing multiple relations into one lexical event."},
    {"id":"c050","from":"line_break","relation":"delays","to":"meaning","operation":"suspension","weight":1,"sources":["user-seven","bruckinger-image"],"note":"A delayed prefix, split word or isolated part can make meaning arrive late."},
    {"id":"c051","from":"blank_space","relation":"structures","to":"encounter","operation":"interval","weight":0.95,"sources":["dichtung-uebergang","celan-meridian"],"note":"Page emptiness and pause create an active interval for encounter."},
    {"id":"c052","from":"poem","relation":"moves_toward","to":"du","operation":"encounter","weight":1,"sources":["celan-bremen","celan-meridian"],"note":"The poem is solitary and on the way, which makes encounter possible."},
    {"id":"c053","from":"poem","relation":"returns_through","to":"self","operation":"meridian","weight":0.9,"sources":["celan-meridian"],"note":"The route can be a detour from self through language toward an answering Other and back."},
    {"id":"c054","from":"question","relation":"opens","to":"gap","operation":"opening","weight":0.94,"sources":["celan-meridian","eliezer-silence"],"note":"An open question leads to an open or empty place rather than a final proposition."},
    {"id":"c055","from":"compression","relation":"removes","to":"explanation","operation":"shortening","weight":1,"sources":["user-seven"],"note":"Manuscript revisions often remove connective explanation while retaining essential words."},
    {"id":"c056","from":"technical_lexicon","relation":"maps","to":"transition","operation":"technicalize","weight":0.9,"sources":["user-seven"],"note":"Aviation and guidance vocabulary maps phases of transition, control and uncertain movement."},
    {"id":"c057","from":"mask","relation":"records","to":"loss","operation":"casting","weight":0.9,"sources":["user-seven"],"note":"The mask is a cast and trace of absence rather than simple concealment."},
    {"id":"c058","from":"residue","relation":"keeps_open","to":"address","operation":"ending","weight":0.96,"sources":["user-seven","celan-meridian"],"note":"What remains can continue to address the Other after presence has receded."},
    {"id":"c059","from":"thicket","relation":"shelters","to":"persistence","operation":"concealment","weight":1,"sources":["user-seven","hearing-residues"],"note":"Hard-leaved scrub combines hiding, thorned resistance and the ability to remain upright."},
    {"id":"c060","from":"thicket","relation":"passes_through","to":"darkness","operation":"approach","weight":0.94,"sources":["user-seven"],"note":"The thicket's dark passage prepares a movement toward the addressed Other rather than simple withdrawal."}
